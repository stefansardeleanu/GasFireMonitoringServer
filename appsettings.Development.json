{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug",
      "GasFireMonitoringServer.Services.DataProcessingService": "Debug",
      "GasFireMonitoringServer.Services.MqttService": "Debug",
      "System.Net.Http.HttpClient": "Information"
    }
  },

  // Development-specific JWT settings (shorter expiration for testing)
  "JwtSettings": {
    "ExpirationDays": 1,
    "ExpirationHours": 24,
    "ClockSkew": "00:05:00"
  },

  // Development-specific MQTT settings
  "MqttSettings": {
    "ClientId": "GasFireMonitoringServer-Dev",
    "KeepAlivePeriod": 60,
    "ConnectTimeout": 30
  },

  // Development-specific application settings
  "ApplicationSettings": {
    "Environment": "Development",
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true,
    "SkipCertificateValidation": true
  },

  // Development-specific performance settings
  "PerformanceSettings": {
    "EnableDetailedMetrics": true,
    "EnableQueryLogging": true,
    "CacheTimeoutMinutes": 5
  }
}