{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "GasFireMonitoringServer.Services.DataProcessingService": "Information",
      "GasFireMonitoringServer.Services.MqttService": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  // Production-specific JWT settings (longer expiration, strict validation)
  "JwtSettings": {
    "ExpirationDays": 7,
    "ClockSkew": "00:01:00",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "RequireHttpsMetadata": true
  },

  // Production-specific MQTT settings
  "MqttSettings": {
    "ClientId": "GasFireMonitoringServer-Prod",
    "KeepAlivePeriod": 30,
    "ConnectTimeout": 10,
    "AutoReconnect": true,
    "MaxReconnectDelay": 60
  },

  // Production-specific application settings
  "ApplicationSettings": {
    "Environment": "Production",
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "SkipCertificateValidation": false,
    "RequireHttps": true
  },

  // Production-specific performance settings
  "PerformanceSettings": {
    "EnableDetailedMetrics": false,
    "EnableQueryLogging": false,
    "CacheTimeoutMinutes": 60,
    "MaxConcurrentConnections": 100
  },

  // Production security settings
  "SecuritySettings": {
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 60,
    "EnableRequestLogging": true,
    "BlockSuspiciousRequests": true
  }
}